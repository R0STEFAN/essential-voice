        android:pathData="M63.06,50.02 A4.25,4.25 0 0,1 71.57,50.02 L71.57,57.98 A4.25,4.25 0 0,1 63.06,57.98 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M80.64,54.09 m-4.25,0 a4.25,4.25 0 1,0 8.51,0 a4.25,4.25 0 1,0 -8.51,0" />
</vector>
